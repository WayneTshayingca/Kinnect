# Supabase project URL (Dashboard > Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public/anon key (Dashboard > Settings > API > anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Dashboard > Settings > API > service_role)
# Server-only — used for email invites. Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Sentry DSN (Dashboard > Settings > Client Keys)
NEXT_PUBLIC_SENTRY_DSN=
