# Copy to .env and fill in. Never commit the filled-in .env.
# Only EXPO_PUBLIC_* vars are readable by the app at runtime — and anything
# with that prefix ships inside the bundle, so it must be safe to publish.

# Supabase project URL (Dashboard > Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Dashboard > Settings > API > anon/public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed web app. Mobile calls its service-role API routes
# (e.g. POST /api/members) and opens PayFast checkout against this origin.
# No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry DSN (safe to ship — it is a public client key)
EXPO_PUBLIC_SENTRY_DSN=

# NOTE: SUPABASE_SERVICE_ROLE_KEY must NEVER appear in this app. It bypasses
# RLS entirely and belongs only in the web app's server-side /api/* routes.
# SENTRY_AUTH_TOKEN is a build-time secret — set it in your shell or in EAS
# secrets, never in a committed file.
