{
  "expo": {
    "name": "Kinnect",
    "slug": "kinnect",
    "version": "1.0.0",
    "scheme": "kinnect",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "africa.kinnect.app"
    },
    "android": {
      "package": "africa.kinnect.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
